    { "id": "node", "category": "JavaScript / TypeScript / Node.js", "matcher": { "type": "product", "vendor": "Node.js", "product": "Node.js" }, "minimumSeverity": "high", "coverageNote": "Runtime product matching is limited to CISA KEV. GitHub package advisories do not provide complete Node.js runtime coverage." },
