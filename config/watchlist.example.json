          { "vendor": "Microsoft", "product": "Windows 11" },
          { "vendor": "Microsoft", "product": "Win32k" },
          { "vendor": "Microsoft", "product": "MSHTML" },
          { "vendor": "Microsoft", "product": "Windows Ancillary Function Driver for WinSock" },
          { "vendor": "Microsoft", "product": "Ancillary Function Driver (afd.sys)" },
          { "vendor": "Microsoft", "product": "Client-Server Run-time Subsystem (CSRSS)" },
